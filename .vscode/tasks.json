{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django Server",
      "type": "shell",
      "command": "${workspaceFolder}/djvenv/Scripts/python.exe",
      "args": ["manage.py", "runserver"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/sitewoman"
      },
      "problemMatcher": []
    },
    {
      "label": "Django Migrate",
      "type": "shell",
      "command": "${workspaceFolder}/djvenv/Scripts/python.exe",
      "args": ["manage.py", "migrate"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/sitewoman"
      }
    },
    {
      "label": "Django Makemigrations",
      "type": "shell",
      "command": "${workspaceFolder}/djvenv/Scripts/python.exe",
      "args": ["manage.py", "makemigrations"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}/sitewoman"
      }
    }
  ]
}
