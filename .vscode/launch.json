{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sitewoman/manage.py",
      "args": ["runserver", "8000"],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Django Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sitewoman/manage.py",
      "args": ["test"],
      "django": true,
      "console": "integratedTerminal"
    }
  ]
}
